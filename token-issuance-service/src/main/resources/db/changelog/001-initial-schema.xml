<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-token-contracts" author="tokenrealty">
        <createTable tableName="token_contracts">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="flat_id" type="uuid"><constraints nullable="false" unique="true"/></column>
            <column name="building_id" type="uuid"><constraints nullable="false"/></column>
            <column name="spv_wallet_address" type="varchar(66)"><constraints nullable="false"/></column>
            <column name="contract_address" type="varchar(66)"/>
            <column name="deployment_tx_hash" type="varchar(66)"/>
            <column name="deployed_at" type="timestamptz"/>
            <column name="total_supply" type="bigint"><constraints nullable="false"/></column>
            <column name="token_price_usd" type="numeric(18,2)"><constraints nullable="false"/></column>
            <column name="token_symbol" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="token_name" type="varchar(255)"><constraints nullable="false"/></column>
            <column name="network" type="varchar(50)"><constraints nullable="false"/></column>
            <column name="chain_id" type="bigint"><constraints nullable="false"/></column>
            <column name="status" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="version" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="002-token-holders" author="tokenrealty">
        <createTable tableName="token_holders">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="token_contract_id" type="uuid"><constraints nullable="false"/></column>
            <column name="investor_id" type="uuid"><constraints nullable="false"/></column>
            <column name="wallet_address" type="varchar(66)"><constraints nullable="false"/></column>
            <column name="balance" type="bigint"><constraints nullable="false"/></column>
            <column name="balance_usd" type="numeric(18,2)"/>
            <column name="ownership_percentage" type="numeric(8,4)"/>
            <column name="kyc_verified" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="whitelisted_on_chain" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="status" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="version" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="token_holders" baseColumnNames="token_contract_id"
                                 referencedTableName="token_contracts" referencedColumnNames="id"
                                 constraintName="fk_holders_contract"/>
        <addUniqueConstraint tableName="token_holders" columnNames="token_contract_id,investor_id"
                             constraintName="uk_holders_contract_investor"/>
    </changeSet>

    <changeSet id="003-token-transfers" author="tokenrealty">
        <createTable tableName="token_transfers">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="token_contract_id" type="uuid"><constraints nullable="false"/></column>
            <column name="from_address" type="varchar(66)"/>
            <column name="to_address" type="varchar(66)"><constraints nullable="false"/></column>
            <column name="amount" type="bigint"><constraints nullable="false"/></column>
            <column name="price_per_token_usd" type="numeric(18,2)"/>
            <column name="total_value_usd" type="numeric(18,2)"/>
            <column name="tx_hash" type="varchar(66)"/>
            <column name="block_number" type="bigint"/>
            <column name="confirmed_at" type="timestamptz"/>
            <column name="type" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="status" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="failure_reason" type="varchar(500)"/>
            <column name="created_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="version" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="token_transfers" baseColumnNames="token_contract_id"
                                 referencedTableName="token_contracts" referencedColumnNames="id"
                                 constraintName="fk_transfers_contract"/>
    </changeSet>

    <changeSet id="004-dividend-payments" author="tokenrealty">
        <createTable tableName="dividend_payments">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="token_contract_id" type="uuid"><constraints nullable="false"/></column>
            <column name="investor_id" type="uuid"><constraints nullable="false"/></column>
            <column name="investor_wallet" type="varchar(66)"><constraints nullable="false"/></column>
            <column name="period_start" type="date"><constraints nullable="false"/></column>
            <column name="period_end" type="date"><constraints nullable="false"/></column>
            <column name="tokens_held" type="bigint"><constraints nullable="false"/></column>
            <column name="ownership_pct" type="numeric(8,4)"/>
            <column name="gross_rental_income_usd" type="numeric(18,2)"/>
            <column name="amount_usd" type="numeric(18,2)"><constraints nullable="false"/></column>
            <column name="amount_matic" type="numeric(18,8)"/>
            <column name="tx_hash" type="varchar(66)"/>
            <column name="paid_at" type="timestamptz"/>
            <column name="status" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="version" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="dividend_payments" baseColumnNames="token_contract_id"
                                 referencedTableName="token_contracts" referencedColumnNames="id"
                                 constraintName="fk_dividends_contract"/>
    </changeSet>

    <changeSet id="005-outbox-events" author="tokenrealty">
        <createTable tableName="outbox_events">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="aggregate_type" type="varchar(50)"><constraints nullable="false"/></column>
            <column name="aggregate_id" type="uuid"><constraints nullable="false"/></column>
            <column name="event_type" type="varchar(120)"><constraints nullable="false"/></column>
            <column name="payload" type="text"><constraints nullable="false"/></column>
            <column name="status" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="published_at" type="timestamptz"/>
            <column name="retry_count" type="int" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="trace_id" type="varchar(64)"/>
        </createTable>
    </changeSet>

    <changeSet id="006-processed-events" author="tokenrealty">
        <createTable tableName="processed_events">
            <column name="event_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_type" type="varchar(120)"><constraints nullable="false"/></column>
            <column name="processed_at" type="timestamptz"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

</databaseChangeLog>
