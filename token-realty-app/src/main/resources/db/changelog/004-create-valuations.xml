<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-valuations" author="tokenrealty">
        <createTable tableName="valuations">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="flat_id" type="uuid"><constraints nullable="false"/></column>
            <column name="valuation_date" type="date"><constraints nullable="false"/></column>
            <column name="value_usd" type="decimal(18,2)"><constraints nullable="false"/></column>
            <column name="value_local_currency" type="decimal(18,2)"/>
            <column name="local_currency" type="char(3)"/>
            <column name="appraiser_name" type="varchar(255)"/>
            <column name="appraiser_license" type="varchar(100)"/>
            <column name="method" type="varchar(30)"><constraints nullable="false"/></column>
            <column name="annual_rental_income_usd" type="decimal(18,2)"/>
            <column name="is_current" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="text"/>
            <column name="created_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="version" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="valuations" baseColumnNames="flat_id"
                referencedTableName="flats" referencedColumnNames="id"
                constraintName="fk_valuations_flat"
                onDelete="CASCADE"/>

        <createIndex tableName="valuations" indexName="idx_valuations_flat_id">
            <column name="flat_id"/>
        </createIndex>
        <!-- Partial index: at most one current valuation per flat -->
        <sql>CREATE UNIQUE INDEX uq_one_current_valuation_per_flat
            ON valuations (flat_id) WHERE is_current = true;</sql>
    </changeSet>

</databaseChangeLog>